# ========================================
# WHATSAPP BOT (Node.js + Baileys)
# ========================================
# O bot usa as URLs acima e precisa de Service Role Key para ler e disparar cobranças sem depender do login do browser.
# Configure pelo menos a empresa que você usa (EMPRESA1 para "nexus", EMPRESA2 para "litoral", etc).
SUPABASE_SERVICE_ROLE_KEY_EMPRESA1=
SUPABASE_SERVICE_ROLE_KEY_EMPRESA2=
SUPABASE_SERVICE_ROLE_KEY_EMPRESA3=
SUPABASE_SERVICE_ROLE_KEY_EMPRESA4=
SUPABASE_SERVICE_ROLE_KEY_EMPRESA5=
SUPABASE_SERVICE_ROLE_KEY_EMPRESA6=

# Porta do bot
PORT=3333

# Intervalo de varredura (ms) e limite de envios por ciclo
BILLING_POLL_INTERVAL_MS=60000
BILLING_BATCH_LIMIT=50

# Mensagem padrão (placeholders: {NOME}, {VALOR}, {VENCIMENTO}, {PARCELA}, {TOTAL_PARCELAS})
BILLING_TEMPLATE=Olá {NOME}, tudo bem?\n\nIdentificamos uma parcela em aberto no valor de {VALOR} com vencimento em {VENCIMENTO} (parcela {PARCELA}/{TOTAL_PARCELAS}).\n\nSe já pagou, por favor desconsidere. Caso precise de segunda via, me avise.

# ========================================
# INSTRUÇÕES PARA DEPLOY NO VERCEL
# ========================================
# 
# 1. No painel do Vercel, vá em Settings > Environment Variables
# 2. Adicione cada uma das variáveis acima
# 3. Certifique-se de que estão marcadas para todos os ambientes (Production, Preview, Development)
# 4. Faça redeploy da aplicação
#
# Exemplo de configuração no Vercel:
# Variable Name: NEXT_PUBLIC_SUPABASE_URL_EMPRESA2
# Value: https://dtifsfzmnjnllzzlndxv.supabase.co
# Environments: Production, Preview, Development
#
# ========================================
# MAPEAMENTO EMPRESA -> VARIÁVEIS
# ========================================
#
# NEXUS (seleção "nexus") - EMPRESA PRINCIPAL:
#   - NEXT_PUBLIC_SUPABASE_URL_EMPRESA1
#   - NEXT_PUBLIC_SUPABASE_ANON_KEY_EMPRESA1  
#   - NEXT_PUBLIC_UPLOADCARE_PUBLIC_KEY_EMPRESA1
#
# LITORAL CRED (seleção "litoral"):
#   - NEXT_PUBLIC_SUPABASE_URL_EMPRESA2
#   - NEXT_PUBLIC_SUPABASE_ANON_KEY_EMPRESA2  
#   - NEXT_PUBLIC_UPLOADCARE_PUBLIC_KEY_EMPRESA2
#
# MOGIANA CRED (seleção "mogiana"):
#   - NEXT_PUBLIC_SUPABASE_URL_EMPRESA3
#   - NEXT_PUBLIC_SUPABASE_ANON_KEY_EMPRESA3
#   - NEXT_PUBLIC_UPLOADCARE_PUBLIC_KEY_EMPRESA3